;; ZuiControl services and the integrated macro power scheduler.
;; system_server remains the refresh and authoritative foreground-scene publisher.
(type zui_control_service)
(typeattributeset service_manager_type (zui_control_service))
(type zui_control_uperf_mode_prop)
(roletype object_r zui_control_uperf_mode_prop)
(typeattributeset property_type (zui_control_uperf_mode_prop))
