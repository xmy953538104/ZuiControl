;; ZuiControl init bind-mount bridge.
;; Init performs file bind mounts, then the shell-domain daemon verifies state.
;; P2 XML apply only prepares active files and asks init to refresh bind mounts.
;; After active XML hash closes, the daemon sends SIGTERM to ZuiPP so its Java
;; config singletons reload the mounted XML. This is not a SIGKILL/crash path.
(type zui_control_service)
(typeattributeset service_manager_type (zui_control_service))
(type zui_control_data_file)
(roletype object_r zui_control_data_file)
(typeattributeset file_type (zui_control_data_file))
(typeattributeset data_file_type (zui_control_data_file))
(typeattributeset core_data_file_type (zui_control_data_file))
(type zui_scheduler_proc)
(roletype object_r zui_scheduler_proc)
(typeattributeset fs_type (zui_scheduler_proc))
(typeattributeset proc_type (zui_scheduler_proc))
(genfscon proc "/sys/walt/input_boost" (u object_r zui_scheduler_proc ((s0) (s0))))
(genfscon proc "/sys/walt/sched_per_task_boost" (u object_r zui_scheduler_proc ((s0) (s0))))
(genfscon proc "/sys/walt/task_reduce_affinity" (u object_r zui_scheduler_proc ((s0) (s0))))
(allow system_server zui_control_service (service_manager (add find)))
(allow priv_app zui_control_service (service_manager (find)))
(allow init system_file (file (mounton)))
(allow shell zui_control_data_file (dir (ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir)))
(allow shell zui_control_data_file (file (ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads)))
(allow shell zui_control_data_file (lnk_file (ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads)))
(allow performanced self (capability (dac_override kill)))
(allow performanced self (process (signal sigkill signull)))
(allow performanced performanced_exec (file (read getattr map execute open execute_no_trans entrypoint)))
(allow performanced shell_exec (file (read getattr map execute open execute_no_trans)))
(allow performanced toolbox_exec (file (read getattr map execute open execute_no_trans)))
(allow performanced zui_control_data_file (dir (getattr open read search write add_name remove_name create setattr)))
(allow performanced zui_control_data_file (file (getattr open read write create append map watch watch_reads setattr unlink)))
(allow performanced appdomain (process (getsched signull)))
(allow performanced sysfs (dir (getattr open read search)))
(allow performanced sysfs_devices_system_cpu (dir (getattr open read search)))
(allow performanced sysfs_devices_system_cpu (file (getattr open read write append setattr)))
(allow performanced proc (dir (getattr open read search)))
(allow performanced proc_stat (file (getattr open read)))
(allow performanced input_device (dir (ioctl read getattr lock open search)))
(allow performanced input_device (chr_file (ioctl read getattr lock map open)))
(allow performanced cgroup (dir (ioctl read write create getattr setattr lock open add_name remove_name search rmdir)))
(allow performanced cgroup (file (ioctl read write create getattr setattr lock append map open unlink)))
(allow performanced zui_scheduler_proc (dir (getattr open read search)))
(allow performanced zui_scheduler_proc (file (getattr open read write append)))
(dontaudit performanced domain (dir (getattr search)))
(allow init shell_data_file (dir (getattr open read search setattr relabelfrom)))
(allow init shell_data_file (file (getattr open read relabelfrom)))
(allow init zui_control_data_file (dir (getattr open read search write add_name remove_name create setattr relabelto)))
(allow init zui_control_data_file (file (getattr open read write create unlink setattr relabelfrom relabelto)))
(allow init zui_control_data_file (file (mounton)))
(allow init system_file (file (unlink setattr relabelto)))
(allow shell self (capability (kill)))
(allow shell system_app (process (signal)))
(allow shell platform_app (process (signal)))
