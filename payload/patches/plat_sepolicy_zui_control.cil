(allow performanced proc_stat (file (getattr open read)))
(allow performanced proc_uptime (file (getattr open read)))
(allow performanced input_device (dir (ioctl read getattr lock open watch watch_reads search)))
(allow performanced input_device (chr_file (ioctl read getattr lock map open)))
(allow performanced cgroup (dir (ioctl read write create getattr setattr lock open add_name remove_name search rmdir)))
(allow performanced cgroup (file (ioctl read write create getattr setattr lock append map open unlink)))
(allow performanced cgroup_v2 (dir (getattr open read search)))
(allow performanced cgroup_v2 (file (getattr open read)))
(allow performanced zui_scheduler_proc (dir (getattr open read search)))
(allow performanced zui_scheduler_proc (file (getattr open read write append setattr)))
(dontaudit performanced domain (dir (getattr search)))
(allow init shell_data_file (dir (getattr open read search setattr relabelfrom)))
(allow init shell_data_file (file (getattr open read relabelfrom)))
(allow init zui_control_data_file (dir (getattr open read search write add_name remove_name create setattr relabelto)))
(allow init zui_control_data_file (file (getattr open read write create unlink setattr relabelfrom relabelto)))

;; ZUIopt direct owner. The authenticated shell oneshot execs this root-only domain.
;; No RT, WALT, GPU, permissive or unconfined permission is introduced here.
(type zuiopt)
(roletype r zuiopt)
(typeattributeset domain (zuiopt))
(typeattributeset coredomain (zuiopt))
;; Cross-category app proc/setsched needs the MLS exception; TE remains independent.
(typeattributeset mlstrustedsubject (zuiopt))
(type zuiopt_exec)
(roletype object_r zuiopt_exec)
(typeattributeset file_type (zuiopt_exec))
(typeattributeset exec_type (zuiopt_exec))
(typeattributeset system_file_type (zuiopt_exec))
(type zuiopt_config_file)
(roletype object_r zuiopt_config_file)
(typeattributeset file_type (zuiopt_config_file))
(typeattributeset system_file_type (zuiopt_config_file))
(type zuiopt_data_file)
(roletype object_r zuiopt_data_file)
(typeattributeset file_type (zuiopt_data_file))
(typeattributeset data_file_type (zuiopt_data_file))
(typeattributeset core_data_file_type (zuiopt_data_file))
(type zuiopt_failure_prop)
(roletype object_r zuiopt_failure_prop)
(typeattributeset property_type (zuiopt_failure_prop))
(typeattributeset system_property_type (zuiopt_failure_prop))
(typeattributeset system_internal_property_type (zuiopt_failure_prop))
(typetransition init zuiopt_exec process zuiopt)
(allow init zuiopt (process (transition rlimitinh siginh signal sigkill)))
(allow init zuiopt_exec (file (getattr open read execute map)))
(allow zuiopt init (process (sigchld)))
(allow zuiopt init (fd (use)))
(allow zuiopt zuiopt_exec (file (getattr open read execute map entrypoint)))
(allow zuiopt system_linker_exec (file (getattr open read execute map)))
(allow zuiopt system_lib_file (file (getattr open read execute map)))
(allow zuiopt system_file (dir (getattr search)))
(allow zuiopt system_file (file (getattr open read map)))
(allow zuiopt null_device (chr_file (getattr open read write ioctl)))
(allow zuiopt self (process (fork sigchld getsched setsched signal sigkill signull setrlimit)))
;; Init owns /dev/cpuset/ZUIopt; affinity needs sys_nice, not DAC bypass.
(allow zuiopt self (capability (sys_nice)))
(allow zuiopt self (fd (use)))
(allow zuiopt self (dir (getattr open read search)))
(allow zuiopt self (file (getattr open read)))
(allow zuiopt self (lnk_file (getattr read)))
(allow zuiopt self (anon_inode (create getattr read write ioctl)))
(allow zuiopt self (fifo_file (getattr read write)))
(allow zuiopt toolbox_exec (file (getattr open read execute execute_no_trans map)))
(allow zuiopt binder_device (chr_file (getattr open read write ioctl map)))
(allow zuiopt servicemanager (binder (call transfer)))
(allow zuiopt servicemanager (dir (search)))
(allow zuiopt servicemanager (file (open read getattr)))
(allow zuiopt activity_service (service_manager (find)))
(allow zuiopt package_service (service_manager (find)))
(allow zuiopt system_server (binder (call transfer)))
(allow system_server zuiopt (binder (call transfer)))
(allow system_server zuiopt (fd (use)))
(allow zuiopt system_server (fd (use)))
(allow zuiopt appdomain (dir (getattr open read search)))
(allow zuiopt appdomain (file (getattr open read)))
(allow zuiopt appdomain (process (getsched setsched signull)))
(allow zuiopt performanced (dir (getattr search)))
(allow zuiopt performanced (lnk_file (getattr read)))
(allow zuiopt proc (dir (getattr open read search)))
(allow zuiopt proc_stat (file (getattr open read)))
(allow zuiopt proc_uptime (file (getattr open read)))
(allow zuiopt proc_random (file (getattr open read)))
(allow zuiopt sysfs (dir (getattr search)))
(allow zuiopt sysfs_devices_system_cpu (dir (getattr search)))
(allow zuiopt sysfs_devices_system_cpu (file (getattr open read)))
(allow zuiopt cgroup (dir (getattr open read search write add_name remove_name create rmdir)))
(allow zuiopt cgroup (file (getattr open read write)))
(allow zuiopt rootfs (dir (getattr search)))
(allow zuiopt system_data_root_file (dir (getattr search)))
(allow zuiopt vendor_data_file (dir (getattr search)))
(allow zuiopt zui_control_data_file (dir (getattr search)))
;; Diagnostic stderr is an inherited descriptor, not permission to open legacy state.
(allow zuiopt zui_control_data_file (file (getattr write append)))
(allow zuiopt zuiopt_config_file (dir (getattr search)))
(allow zuiopt zuiopt_config_file (file (getattr open read)))
(allow zuiopt zuiopt_data_file (dir (getattr open read search write add_name remove_name create rmdir)))
(allow zuiopt zuiopt_data_file (file (getattr open read write create lock rename unlink)))
(allow init zuiopt_data_file (dir (getattr open read search write add_name remove_name create setattr relabelto)))
(allow init zuiopt_data_file (file (getattr open read write create setattr relabelto)))
(allow shell zuiopt_exec (file (getattr open read execute map)))
;; init invokes these read-only boot/crash scripts through /system/bin/sh.
(allow shell zuiopt_config_file (dir (getattr search)))
(allow shell zuiopt_config_file (file (getattr open read)))
(typetransition shell zuiopt_exec process zuiopt)
(allow shell zuiopt (process (transition rlimitinh siginh)))
(allow zuiopt shell (process (sigchld)))
(allow zuiopt shell (fd (use)))
(allow zuiopt shell (fifo_file (getattr read write)))
(allow zuiopt zui_control_scheduler_active_prop (file (getattr open read map)))
(allow init zuiopt_failure_prop (property_service (set)))
(allow shell zuiopt_failure_prop (property_service (set)))
(allow shell zuiopt_failure_prop (file (getattr open read map)))
(allow zuiopt zuiopt_failure_prop (file (getattr open read map)))
(allow system_server zuiopt_failure_prop (file (getattr open read map)))
