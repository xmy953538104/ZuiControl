;; Uperf owns the Snapdragon msm_performance CPU controls. KGSL remains under
;; the OEM DVFS/thermal stack in this phase.
;; The service runs in the platform performanced domain, seen here through the
;; public 34.0 mapping type used by vendor policy.
(allow performanced_34_0 vendor_sysfs_msm_perf (dir (ioctl read getattr lock open search)))
(allow performanced_34_0 vendor_sysfs_msm_perf (file (ioctl read write getattr setattr lock append map open)))
