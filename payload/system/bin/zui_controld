#!/system/bin/sh

DATA_ROOT=/data/vendor/zui_control
CONTROL_DIR=$DATA_ROOT/zuicontrol
UPERF_DIR=$DATA_ROOT/uperf
ASOUL_DIR=$DATA_ROOT/asoul
LOG_DIR=$DATA_ROOT/log

LOG_FILE=$LOG_DIR/controld.log
UPERF_LOG=$LOG_DIR/uperf.log
STATUS_FILE=$CONTROL_DIR/status.prop
LAST_REQUEST_RECEIPT=$CONTROL_DIR/last_request_receipt

UPERF_MODE=$UPERF_DIR/cur_powermode.txt
UPERF_EFFECTIVE_MODE=$UPERF_DIR/effective_powermode.txt
UPERF_PERAPP=$UPERF_DIR/perapp_powermode.txt
ASOUL_CONFIG=$ASOUL_DIR/asopt.conf

APP_PACKAGE=com.zui.zuicontrol
APP_SERVICE_COMPONENT=$APP_PACKAGE/$APP_PACKAGE.ZuiControlQuickService
PROP_SCHEDULER=zui_control.scheduler
PROP_ASOUL=zui_control.asoul

REQ_TEXT_KEY=zui_control_request_text
REQUEST_ACK_KEY=zui_control_request_ack
STATUS_TIME_KEY=zui_control_status_time
STATUS_LAST_KEY=zui_control_status_last
DAEMON_STATUS_KEY=zui_control_daemon_status_text
DAEMON_REFRESH_STATE_KEY=zui_control_daemon_refresh_state
ASOUL_HEALTH_KEY=zui_control_asoul_health
UPERF_HEALTH_KEY=zui_control_uperf_health
UPERF_MODE_KEY=zui_control_uperf_mode
UPERF_RULES_KEY=zui_control_uperf_rules_text
UPERF_SCENE_KEY=zui_control_top_package
UPERF_SCREEN_KEY=zui_control_screen_on
LOG_EXPORT_KEY=zui_control_log_export

LAST_SETTINGS_REQUEST=
CURRENT_REQUEST_ID=
CURRENT_REQUEST_CMD=
REQUEST_RESULT_DETAIL=
HEALTH_TICKS=0
UPERF_MISSES=0
UPERF_FRONTEND_SCENE=
UPERF_FRONTEND_SCREEN=1
UPERF_FRONTEND_SOURCE=global
UPERF_FRONTEND_EFFECTIVE=balance

ts() {
    date '+%Y-%m-%d %H:%M:%S'
}

settings_get_clean() {
    value="$(settings get system "$1" 2>/dev/null)"
    [ "$value" != "null" ] || value=
    printf '%s\n' "$value"
}

settings_put_quiet() {
    settings put system "$1" "$2" >/dev/null 2>&1
}

atomic_write_text() {
    target="$1"
    value="$2"
    tmp="$target.tmp"
    rm -f "$tmp"
    if printf '%s\n' "$value" > "$tmp" &&
        chmod 0664 "$tmp" &&
        mv -f "$tmp" "$target"; then
        sync "$target" 2>/dev/null || sync
        return 0
    fi
    rm -f "$tmp"
    return 1
}

log_line() {
    mkdir -p "$LOG_DIR"
    printf '%s %s\n' "$(ts)" "$*" >> "$LOG_FILE"
}

trim_log() {
    [ -s "$LOG_FILE" ] || return 0
    size="$(wc -c < "$LOG_FILE" 2>/dev/null)"
    if [ "${size:-0}" -gt 524288 ]; then
        tail -n 2000 "$LOG_FILE" > "$LOG_FILE.tmp" 2>/dev/null &&
            mv -f "$LOG_FILE.tmp" "$LOG_FILE"
    fi
}

set_status() {
    {
        echo "time=$(ts)"
        for line in "$@"; do echo "$line"; done
    } > "$STATUS_FILE"
    chmod 0664 "$STATUS_FILE" 2>/dev/null
    last=
    for line in "$@"; do
        case "$line" in last=*) last="${line#last=}" ;; esac
    done
    settings_put_quiet "$STATUS_TIME_KEY" "$(ts)"
    settings_put_quiet "$STATUS_LAST_KEY" "$last"
    settings_put_quiet "$DAEMON_STATUS_KEY" "$(tr '\n' ';' < "$STATUS_FILE" 2>/dev/null)"
}

valid_package_name() {
    case "$1" in
        ""|.*|*.|*..*|*[!A-Za-z0-9_.]*) return 1 ;;
    esac
    return 0
}

package_is_user_app() {
    apk="$(pm path "$1" </dev/null 2>/dev/null | sed -n 's/^package://p' | head -n 1)"
    case "$apk" in /data/app/*) return 0 ;; esac
    return 1
}

valid_uperf_preset() {
    case "$1" in
        powersave|balance|performance|fast) return 0 ;;
        *) return 1 ;;
    esac
}

uperf_rule_for_scene() {
    wanted="$1"
    while read -r rule_pkg rule_mode extra; do
        [ -z "$extra" ] || continue
        case "$rule_pkg" in ''|'#'*|'-'|'*') continue ;; esac
        if [ "$rule_pkg" = "$wanted" ] && valid_uperf_preset "$rule_mode"; then
            printf '%s\n' "$rule_mode"
            return 0
        fi
    done < "$UPERF_PERAPP" 2>/dev/null
    return 1
}

write_uperf_effective_mode() {
    next="$1"
    valid_uperf_preset "$next" || return 1
    current="$(tr -d '\r\n ' < "$UPERF_EFFECTIVE_MODE" 2>/dev/null)"
    [ "$current" != "$next" ] || return 0
    # Uperf watches this inode, so never replace the effective file with rename(2).
    if printf '%s\n' "$next" > "$UPERF_EFFECTIVE_MODE" &&
        chmod 0644 "$UPERF_EFFECTIVE_MODE"; then
        sync "$UPERF_EFFECTIVE_MODE" 2>/dev/null || sync
        log_line "Uperf effective=$next source=$UPERF_FRONTEND_SOURCE scene=$UPERF_FRONTEND_SCENE screen=$UPERF_FRONTEND_SCREEN"
        return 0
    fi
    return 1
}

sync_uperf_frontend() {
    global_mode="$(tr -d '\r\n ' < "$UPERF_MODE" 2>/dev/null)"
    if ! valid_uperf_preset "$global_mode"; then
        global_mode=balance
        atomic_write_text "$UPERF_MODE" "$global_mode" || return 1
    fi

    scene="$(settings_get_clean "$UPERF_SCENE_KEY")"
    valid_package_name "$scene" || scene=
    screen="$(settings_get_clean "$UPERF_SCREEN_KEY")"
    [ "$screen" = "0" ] || screen=1

    if [ "$screen" = "0" ]; then
        effective="$(awk '$1 == "-" {print $2; exit}' "$UPERF_PERAPP" 2>/dev/null)"
        valid_uperf_preset "$effective" || effective=powersave
        source=screen_off
    elif [ -n "$scene" ]; then
        effective="$(uperf_rule_for_scene "$scene")"
        if valid_uperf_preset "$effective"; then
            source="app:$scene"
        else
            effective="$global_mode"
            source=global
        fi
    else
        effective="$global_mode"
        source=global
    fi

    UPERF_FRONTEND_SCENE="$scene"
    UPERF_FRONTEND_SCREEN="$screen"
    UPERF_FRONTEND_SOURCE="$source"
    UPERF_FRONTEND_EFFECTIVE="$effective"
    write_uperf_effective_mode "$effective"
}

publish_uperf_rules_state() {
    rules=
    while read -r rule_pkg rule_mode extra; do
        [ -z "$extra" ] || continue
        case "$rule_pkg" in ''|'#'*|'-'|'*') continue ;; esac
        valid_package_name "$rule_pkg" || continue
        valid_uperf_preset "$rule_mode" || continue
        rules="${rules}${rule_pkg}|${rule_mode}
"
    done < "$UPERF_PERAPP" 2>/dev/null
    settings_put_quiet "$UPERF_RULES_KEY" "$(printf '%s' "$rules" | sed '/^$/d')"
}

oem_bridge_state() {
    result=
    for bridge in vendor.perfservice performance poweropt-service perf2-hal-1-0; do
        state="$(getprop "init.svc.$bridge" 2>/dev/null)"
        [ -n "$state" ] || state=absent
        [ -z "$result" ] || result="$result · "
        result="${result}${bridge}=${state}"
    done
    printf '%s\n' "$result"
}

publish_scheduler_health() {
    sync_uperf_frontend >/dev/null 2>&1 || true
    uperf_pids="$(pidof uperf 2>/dev/null)"
    uperf_pid="$(printf '%s\n' "$uperf_pids" | awk '{print $1}')"
    uperf_processes="$(printf '%s\n' "$uperf_pids" | awk '{print NF}')"
    asoul_pid="$(pidof AsoulOpt 2>/dev/null | awk '{print $1}')"
    global_mode="$(tr -d '\r\n ' < "$UPERF_MODE" 2>/dev/null)"
    valid_uperf_preset "$global_mode" || global_mode=unknown
    effective="$(tr -d '\r\n ' < "$UPERF_EFFECTIVE_MODE" 2>/dev/null)"
    valid_uperf_preset "$effective" || effective=unknown
    log_size=0
    [ -f "$UPERF_LOG" ] && log_size="$(wc -c < "$UPERF_LOG" 2>/dev/null)"
    health="Uperf：${uperf_pid:-未运行}（${uperf_processes:-0} 进程 · u:r:performanced:s0）
全局模式：$global_mode · 实际档位：$effective · 来源：${UPERF_FRONTEND_SOURCE:-global}
前端场景：${UPERF_FRONTEND_SCENE:-无} · 亮屏：$UPERF_FRONTEND_SCREEN
GPU：原厂 KGSL DVFS 与热保护保留
OEM Perf 桥：$(oem_bridge_state)（存在的服务均应为 stopped）
A-SOUL：${asoul_pid:-未运行}（u:r:performanced:s0）
线程参数：$(tr '\n' ' ' < "$ASOUL_CONFIG" 2>/dev/null)
日志：${log_size:-0} 字节"
    settings_put_quiet "$UPERF_HEALTH_KEY" "$health"
    settings_put_quiet "$ASOUL_HEALTH_KEY" "$health"
    settings_put_quiet "$UPERF_MODE_KEY" "$global_mode"
    publish_uperf_rules_state
}

set_uperf_mode() {
    requested="$1"
    valid_uperf_preset "$requested" || return 1
    atomic_write_text "$UPERF_MODE" "$requested" || return 1
    sync_uperf_frontend || return 1
    settings_put_quiet "$UPERF_MODE_KEY" "$requested"
    REQUEST_RESULT_DETAIL="global=$requested;effective=$UPERF_FRONTEND_EFFECTIVE"
    log_line "Uperf global mode=$requested effective=$UPERF_FRONTEND_EFFECTIVE"
}

write_perapp_without_package() {
    remove_pkg="$1"
    tmp="$UPERF_PERAPP.tmp"
    awk -v pkg="$remove_pkg" '$1 != pkg {print}' "$UPERF_PERAPP" > "$tmp" || {
        rm -f "$tmp"
        return 1
    }
    cat "$tmp" > "$UPERF_PERAPP" || {
        rm -f "$tmp"
        return 1
    }
    rm -f "$tmp"
    chmod 0644 "$UPERF_PERAPP"
    sync "$UPERF_PERAPP" 2>/dev/null || sync
}

set_uperf_app_mode() {
    requested_pkg="$1"
    requested_mode="$2"
    valid_package_name "$requested_pkg" || return 1
    package_is_user_app "$requested_pkg" || return 1
    valid_uperf_preset "$requested_mode" || return 1
    tmp="$UPERF_PERAPP.tmp"
    awk -v pkg="$requested_pkg" -v mode="$requested_mode" '
        $1 == pkg {next}
        !inserted && $1 == "-" {print pkg " " mode; inserted=1}
        {print}
        END {if (!inserted) print pkg " " mode}
    ' "$UPERF_PERAPP" > "$tmp" || {
        rm -f "$tmp"
        return 1
    }
    cat "$tmp" > "$UPERF_PERAPP" || {
        rm -f "$tmp"
        return 1
    }
    rm -f "$tmp"
    chmod 0644 "$UPERF_PERAPP"
    sync "$UPERF_PERAPP" 2>/dev/null || sync
    publish_uperf_rules_state
    sync_uperf_frontend || return 1
    REQUEST_RESULT_DETAIL="package=$requested_pkg;mode=$requested_mode"
    log_line "Uperf app package=$requested_pkg mode=$requested_mode"
}

remove_uperf_app_mode() {
    requested_pkg="$1"
    valid_package_name "$requested_pkg" || return 1
    write_perapp_without_package "$requested_pkg" || return 1
    publish_uperf_rules_state
    sync_uperf_frontend || return 1
    REQUEST_RESULT_DETAIL="package=$requested_pkg;mode=global"
    log_line "Uperf app removed package=$requested_pkg"
}

trigger_init_action() {
    prop="$1"
    value="$2"
    setprop "$prop" idle >> "$LOG_FILE" 2>&1
    if setprop "$prop" "$value" >> "$LOG_FILE" 2>&1; then
        log_line "init action $prop=$value"
        return 0
    fi
    log_line "init action failed $prop=$value"
    return 1
}

uperf_is_healthy() {
    processes="$(pidof uperf 2>/dev/null | awk '{print NF}')"
    [ "${processes:-0}" -ge 2 ] 2>/dev/null &&
        grep -q ' I Uperf is running$' "$UPERF_LOG" 2>/dev/null &&
        ! grep -q ' I Failed to start uperf' "$UPERF_LOG" 2>/dev/null
}

restart_scheduler() {
    publish_request_progress restarting_scheduler
    trigger_init_action "$PROP_SCHEDULER" restart || return 1
    tries=20
    while [ "$tries" -gt 0 ]; do
        sleep 1
        if uperf_is_healthy && [ -n "$(pidof AsoulOpt 2>/dev/null)" ]; then
            UPERF_MISSES=0
            publish_scheduler_health
            REQUEST_RESULT_DETAIL="uperf=running;asoul=running"
            return 0
        fi
        tries=$((tries - 1))
    done
    publish_scheduler_health
    return 1
}

start_asoul() {
    trigger_init_action "$PROP_ASOUL" start || return 1
    sleep 1
    [ -n "$(pidof AsoulOpt 2>/dev/null)" ] || return 1
    publish_scheduler_health
    REQUEST_RESULT_DETAIL="asoul=running;mode=0;rt=0"
}

stop_asoul() {
    trigger_init_action "$PROP_ASOUL" stop || return 1
    sleep 1
    [ -z "$(pidof AsoulOpt 2>/dev/null)" ] || return 1
    publish_scheduler_health
    REQUEST_RESULT_DETAIL="asoul=stopped"
}

ensure_scheduler_running() {
    [ "$(getprop "$PROP_SCHEDULER" 2>/dev/null)" != "stopped" ] || return 0
    for bridge in vendor.perfservice performance poweropt-service perf2-hal-1-0; do
        if [ "$(getprop "init.svc.$bridge" 2>/dev/null)" = "running" ]; then
            log_line "OEM perf bridge escaped fence: $bridge"
            trigger_init_action "$PROP_SCHEDULER" fence || true
            break
        fi
    done
    asoul_state="$(getprop "$PROP_ASOUL" 2>/dev/null)"
    if uperf_is_healthy &&
        { [ "$asoul_state" = "stopped" ] || [ -n "$(pidof AsoulOpt 2>/dev/null)" ]; }; then
        UPERF_MISSES=0
        return 0
    fi
    UPERF_MISSES=$((UPERF_MISSES + 1))
    if [ "$UPERF_MISSES" -ge 3 ]; then
        log_line "scheduler health restart after $UPERF_MISSES misses"
        restart_scheduler || log_line "scheduler health restart failed"
        UPERF_MISSES=0
    fi
}

publish_refresh_state() {
    settings_put_quiet "$DAEMON_REFRESH_STATE_KEY" \
        "refresh_owner=system;daemon refresh disabled"
}

export_logs() {
    publish_scheduler_health
    export_text="ZuiControl 运行记录
导出时间：$(ts)

[状态]
$(cat "$STATUS_FILE" 2>/dev/null)

[刷新率 owner]
$(settings_get_clean "$DAEMON_REFRESH_STATE_KEY")

[Uperf 全局模式]
$(cat "$UPERF_MODE" 2>/dev/null)

[Uperf 实际档位]
$(cat "$UPERF_EFFECTIVE_MODE" 2>/dev/null)
scene=$(settings_get_clean "$UPERF_SCENE_KEY")
screen=$(settings_get_clean "$UPERF_SCREEN_KEY")

[Uperf 自定义应用]
$(cat "$UPERF_PERAPP" 2>/dev/null)

[A-SOUL 配置]
$(cat "$ASOUL_CONFIG" 2>/dev/null)

[调度健康状态]
$(settings_get_clean "$UPERF_HEALTH_KEY")

[守护服务日志末尾]
$(tail -n 120 "$LOG_FILE" 2>/dev/null)

[Uperf 日志末尾]
$(tail -n 80 "$UPERF_LOG" 2>/dev/null)"
    settings_put_quiet "$LOG_EXPORT_KEY" "$export_text"
    set_status "daemon=running" "last=export_logs"
}

sanitize_ack_field() {
    printf '%s' "$1" | tr '|\r\n' '   '
}

ack_text() {
    printf '%s|%s|%s|%s\n' \
        "$(sanitize_ack_field "$1")" \
        "$(sanitize_ack_field "$2")" \
        "$(sanitize_ack_field "$3")" \
        "$(sanitize_ack_field "$4")"
}

publish_request_ack() {
    settings_put_quiet "$REQUEST_ACK_KEY" "$(ack_text "$1" "$2" "$3" "$4")"
}

publish_request_progress() {
    [ -n "$CURRENT_REQUEST_ID" ] && [ -n "$CURRENT_REQUEST_CMD" ] || return 0
    publish_request_ack "$CURRENT_REQUEST_ID" processing "$CURRENT_REQUEST_CMD" "$1"
}

request_field() {
    printf '%s\n' "$1" | cut -d '|' -f "$2"
}

request_field_count() {
    printf '%s\n' "$1" | awk -F '|' 'NR == 1 {print NF; exit}'
}

load_last_receipt() {
    [ -s "$LAST_REQUEST_RECEIPT" ] || return 1
    [ "$(sed -n '$=' "$LAST_REQUEST_RECEIPT" 2>/dev/null)" = "2" ] || return 1
    replay_request="$(sed -n '1p' "$LAST_REQUEST_RECEIPT" | tr -d '\r')"
    replay_ack="$(sed -n '2p' "$LAST_REQUEST_RECEIPT" | tr -d '\r')"
    [ -n "$replay_request" ] && [ -n "$replay_ack" ] || return 1
    [ "$(request_field "$replay_request" 1)" = "$(request_field "$replay_ack" 1)" ] || return 1
    [ "$(request_field "$replay_request" 2)" = "$(request_field "$replay_ack" 3)" ] || return 1
    case "$(request_field "$replay_ack" 2)" in done|failed) ;; *) return 1 ;; esac
}

persist_completion() {
    request="$1"
    terminal_ack="$2"
    atomic_write_text "$LAST_REQUEST_RECEIPT" "$request
$terminal_ack" || return 1
    LAST_SETTINGS_REQUEST="$request"
}

finish_request() {
    request="$1"
    id="$2"
    cmd="$3"
    result="$4"
    detail="$5"
    if [ "$result" = "0" ]; then
        state=done
        detail="${detail:-ok}"
    else
        state=failed
        detail="${detail:-command_failed}"
    fi
    terminal_ack="$(ack_text "$id" "$state" "$cmd" "$detail")"
    persist_completion "$request" "$terminal_ack" || return 1
    settings_put_quiet "$REQUEST_ACK_KEY" "$terminal_ack"
    CURRENT_REQUEST_ID=
    CURRENT_REQUEST_CMD=
    return "$result"
}

handle_command() {
    cmd="$1"
    pkg="$2"
    mode="$3"
    REQUEST_RESULT_DETAIL=
    case "$cmd" in
        status)
            publish_refresh_state
            publish_scheduler_health
            set_status "daemon=running" "last=status"
            ;;
        set_uperf_mode) set_uperf_mode "$mode" ;;
        set_uperf_app)
            publish_request_progress validating_target
            set_uperf_app_mode "$pkg" "$mode"
            ;;
        remove_uperf_app) remove_uperf_app_mode "$pkg" ;;
        restart_scheduler) restart_scheduler ;;
        start_asoul) start_asoul ;;
        stop_asoul) stop_asoul ;;
        export_logs) export_logs ;;
        *) REQUEST_RESULT_DETAIL=unknown_command; return 1 ;;
    esac
}

process_settings_request() {
    request="$(settings_get_clean "$REQ_TEXT_KEY")"
    [ -n "$request" ] || return 0
    if [ "$request" = "$LAST_SETTINGS_REQUEST" ]; then
        load_last_receipt && settings_put_quiet "$REQUEST_ACK_KEY" "$replay_ack"
        return 0
    fi
    id="$(request_field "$request" 1)"
    cmd="$(request_field "$request" 2)"
    pkg="$(request_field "$request" 4)"
    mode="$(request_field "$request" 5)"
    if [ "$(request_field_count "$request")" != "5" ] || [ -z "$id" ] || [ -z "$cmd" ]; then
        finish_request "$request" "${id:-invalid}" "${cmd:-invalid}" 1 invalid_request
        return $?
    fi
    CURRENT_REQUEST_ID="$id"
    CURRENT_REQUEST_CMD="$cmd"
    publish_request_progress validating
    log_line "request id=$id cmd=$cmd pkg=$pkg mode=$mode"
    handle_command "$cmd" "$pkg" "$mode"
    result=$?
    trim_log
    finish_request "$request" "$id" "$cmd" "$result" "$REQUEST_RESULT_DETAIL"
}

grant_app_permissions() {
    pm grant "$APP_PACKAGE" android.permission.POST_NOTIFICATIONS >/dev/null 2>&1
    appops set "$APP_PACKAGE" POST_NOTIFICATION allow >/dev/null 2>&1
    appops set "$APP_PACKAGE" WRITE_SETTINGS allow >/dev/null 2>&1
}

notify_quick_service() {
    am start-foreground-service \
        -a com.zui.zuicontrol.action.REFRESH_NOTIFICATION \
        -n "$APP_SERVICE_COMPONENT" >/dev/null 2>&1 ||
        am startservice -n "$APP_SERVICE_COMPONENT" >/dev/null 2>&1
}

init_dirs() {
    mkdir -p "$CONTROL_DIR" "$UPERF_DIR" "$ASOUL_DIR" "$LOG_DIR" || return 1
    chmod 0775 "$DATA_ROOT" "$CONTROL_DIR" "$UPERF_DIR" "$ASOUL_DIR" "$LOG_DIR" 2>/dev/null
    restorecon_recursive "$DATA_ROOT" >/dev/null 2>&1 || true
    grant_app_permissions
}

init_request_state() {
    LAST_SETTINGS_REQUEST=
    if load_last_receipt; then
        LAST_SETTINGS_REQUEST="$replay_request"
        settings_put_quiet "$REQUEST_ACK_KEY" "$replay_ack"
    else
        rm -f "$LAST_REQUEST_RECEIPT"
    fi
}

main_loop() {
    init_dirs || return 1
    init_request_state
    log_line "zui_controld v49 start: scheduler=uperf+asoul"
    publish_refresh_state
    sync_uperf_frontend || log_line "Uperf frontend initial sync deferred"
    publish_scheduler_health
    set_status "daemon=running" "last=init" "refresh_owner=system"
    notify_quick_service

    while true; do
        process_settings_request
        sync_uperf_frontend >/dev/null 2>&1 || true
        HEALTH_TICKS=$((HEALTH_TICKS + 1))
        if [ "$HEALTH_TICKS" -ge 20 ]; then
            ensure_scheduler_running
            publish_scheduler_health
            HEALTH_TICKS=0
        fi
        sleep 1
    done
}

if [ "${ZUI_CONTROLD_TEST_MODE:-0}" != "1" ]; then
    main_loop
fi
