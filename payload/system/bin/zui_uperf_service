#!/system/bin/sh

CONFIG=/data/vendor/zui_control/uperf/uperf.json
LOG=/data/vendor/zui_control/log/uperf.log
READY_UPTIME=/data/vendor/zui_control/uperf/.service_ready_uptime
SUPERVISOR=/system/bin/zui_uperf_supervisor
BINARY=/system/bin/uperf

# The shell-domain control plane validates/migrates policy and selects config.
# Init clears this authorization at boot and before every explicit preparation.
# Automatic supervisor restarts reuse only the exact authorized bytes; they never
# launch ART/Binder or redo migration in the performanced execution domain.
AUTH=/data/vendor/zui_control/uperf/.validated_runtime.sha256
secure_file() {
    [ -f "$1" ] && [ ! -L "$1" ] || return 1
    file_identity="$(stat -c '%u:%h:%a' "$1")" || return 1
    case "$file_identity" in 0:1:*) ;; *) return 1 ;; esac
    file_mode="${file_identity##*:}"
    case "$file_mode" in ''|*[!0-7]*) return 1 ;; esac
    [ "$((8#$file_mode & 8#22))" -eq 0 ]
}
secure_file "$AUTH" && secure_file "$CONFIG" || exit 1
expected="$(cat "$AUTH")" || exit 1
# This domain owns executable reads. Validate both selected config and pinned
# ROM binary before any Uperf code executes, including automatic restarts.
actual="$(sha256sum "$CONFIG" "$BINARY")" || exit 1
[ "$expected" = "$actual" ] || exit 1

# The exec keeps init's service PID/cgroup while removing the shell from the
# steady process chain. The native supervisor owns readiness and tree lifetime.
echo $$ > /dev/cpuset/background/tasks 2>/dev/null || true
exec "$SUPERVISOR" "$CONFIG" "$LOG" "$READY_UPTIME"
