#!/system/bin/sh

CONFIG=/data/vendor/zui_control/uperf/uperf.json
LOG=/data/vendor/zui_control/log/uperf.log

# Uperf daemonizes. Keep this init service alive so init owns and can reliably
# stop the entire service cgroup, including the detached Uperf child.
# The author's module moves Uperf itself out of the foreground cpuset; children
# inherit this placement while their writes still control the configured CPU
# and GPU policy nodes.
echo $$ > /dev/cpuset/background/tasks 2>/dev/null || true
killall -15 uperf 2>/dev/null || true
sleep 1
: > "$LOG" 2>/dev/null || true
/system/bin/uperf "$CONFIG" -o "$LOG" || exit 1

tries=20
while [ "$tries" -gt 0 ]; do
    pidof uperf >/dev/null 2>&1 && break
    sleep 1
    tries=$((tries - 1))
done
pidof uperf >/dev/null 2>&1 || exit 1

while pidof uperf >/dev/null 2>&1; do
    sleep 5
done
exit 1
