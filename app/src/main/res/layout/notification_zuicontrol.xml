<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="48dp"
    android:gravity="center_vertical" android:orientation="horizontal">
    <ImageView android:id="@+id/monitor_toggle"
        android:layout_width="44dp" android:layout_height="44dp"
        android:layout_marginEnd="8dp" android:padding="11dp"
        android:contentDescription="监视器" android:src="@drawable/ic_nav_display_rate"
        android:background="@drawable/notify_rate_normal" />
    <LinearLayout android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:orientation="horizontal">
            <TextView android:id="@+id/refresh_60" style="@style/NotificationRefresh" android:text="60" />
            <TextView android:id="@+id/refresh_90" style="@style/NotificationRefresh" android:text="90" />
            <TextView android:id="@+id/refresh_120" style="@style/NotificationRefresh" android:text="120" />
            <TextView android:id="@+id/refresh_144" style="@style/NotificationRefresh" android:text="144" />
            <TextView android:id="@+id/refresh_165" style="@style/NotificationRefresh" android:text="165" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="24dp">
            <ImageView android:layout_width="match_parent" android:layout_height="1dp"
                android:layout_marginStart="28dp" android:layout_marginEnd="28dp" android:layout_marginTop="6dp"
                android:background="#CDD4DF" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
                <TextView android:id="@+id/mode_powersave" style="@style/NotificationMode" />
                <TextView android:id="@+id/mode_balance" style="@style/NotificationMode" />
                <TextView android:id="@+id/mode_performance" style="@style/NotificationMode" />
                <TextView android:id="@+id/mode_fast" style="@style/NotificationMode" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
