<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_root" android:layout_width="match_parent" android:layout_height="88dp"
    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp"
    android:background="@drawable/notify_card" android:orientation="horizontal">
    <FrameLayout android:id="@+id/monitor_toggle" android:layout_width="64dp" android:layout_height="64dp"
        android:layout_gravity="center_vertical" android:contentDescription="监视器 关闭"
        android:background="@drawable/notify_monitor_active">
        <ImageView android:id="@+id/monitor_icon" android:layout_width="64dp" android:layout_height="64dp"
            android:layout_gravity="center" android:src="@drawable/notify_monitor_ecg"
            android:importantForAccessibility="no" />
        <ImageView android:id="@+id/monitor_indicator" android:layout_width="16dp" android:layout_height="16dp"
            android:layout_gravity="bottom|end" android:layout_marginEnd="1dp" android:layout_marginBottom="1dp"
            android:src="@drawable/notify_monitor_indicator" android:visibility="gone" android:importantForAccessibility="no" />
    </FrameLayout>
    <LinearLayout android:id="@+id/quick_metrics" android:layout_width="56dp" android:layout_height="64dp"
        android:layout_marginStart="14dp" android:orientation="vertical">
        <TextView android:id="@+id/notification_quiet" style="@style/NotificationMetric" android:text="--°C" />
        <TextView android:id="@+id/notification_power" style="@style/NotificationMetric" android:text="-- W" android:layout_marginTop="4dp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/quick_controls" android:layout_width="0dp" android:layout_weight="1" android:layout_height="64dp"
        android:layout_marginStart="14dp" android:orientation="vertical">
        <LinearLayout android:id="@+id/refresh_row" android:layout_width="match_parent" android:layout_height="30dp" android:padding="2dp" android:background="@drawable/notify_capsule_track" android:orientation="horizontal">
            <TextView android:id="@+id/refresh_60" style="@style/NotificationControl" android:text="60" />
            <TextView android:id="@+id/refresh_90" style="@style/NotificationControl" android:text="90" android:layout_marginStart="4.5dp" />
            <TextView android:id="@+id/refresh_120" style="@style/NotificationControl" android:text="120" android:layout_marginStart="4.5dp" />
            <TextView android:id="@+id/refresh_144" style="@style/NotificationControl" android:text="144" android:layout_marginStart="4.5dp" />
            <TextView android:id="@+id/refresh_165" style="@style/NotificationControl" android:text="165" android:layout_marginStart="4.5dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/uperf_row" android:layout_width="match_parent" android:layout_height="30dp" android:padding="2dp" android:background="@drawable/notify_capsule_track" android:orientation="horizontal" android:layout_marginTop="4dp">
            <TextView android:id="@+id/mode_powersave" style="@style/NotificationControl" android:text="节能" />
            <TextView android:id="@+id/mode_balance" style="@style/NotificationControl" android:text="均衡" android:layout_marginStart="4.667dp" />
            <TextView android:id="@+id/mode_performance" style="@style/NotificationControl" android:text="性能" android:layout_marginStart="4.667dp" />
            <TextView android:id="@+id/mode_fast" style="@style/NotificationControl" android:text="快速" android:layout_marginStart="4.667dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
