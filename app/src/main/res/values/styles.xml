<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NotificationRateButton">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#1C222A</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:background">@drawable/notify_rate_normal</item>
    </style>

    <style name="Theme.ZuiControl" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#445B8B</item>
        <item name="android:windowBackground">#F8F7FC</item>
        <item name="android:statusBarColor">#F8F7FC</item>
        <item name="android:navigationBarColor">#F8F7FC</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
