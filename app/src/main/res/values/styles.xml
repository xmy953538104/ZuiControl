<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NotificationControl">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">28dp</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#334155</item>
        <item name="android:background">@drawable/notify_rate_normal</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Theme.ZuiControl" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/ui_accent</item>
        <item name="android:windowBackground">#F8F7FC</item>
        <item name="android:statusBarColor">#F8F7FC</item>
        <item name="android:navigationBarColor">#F8F7FC</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
