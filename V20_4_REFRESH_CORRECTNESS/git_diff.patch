+    def test_five_rates_and_unsupported_are_exact(self) -> None:
+        for hz in ALLOWED_HZ:
+            model = RefreshModel()
+            self.assertEqual("savedOnly", model.set_explicit_profile("app.rate", hz))
+            model.focus("app.rate")
+            self.assertEqual(hz, model.applied_hz)
